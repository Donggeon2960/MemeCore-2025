# backend/.env 로 복사해서 사용: cp .env.example .env

# --- Auth ---
# 32자 이상 랜덤 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=""
# CORS 허용 + 지갑 로그인 메시지에 들어가는 프론트 주소 (쉼표로 여러 개 가능, 첫 번째가 서명 메시지에 사용됨)
FRONTEND_URL="http://localhost:3001"

# --- Blockchain Config ---
RPC_URL="https://rpc.insectarium.memecore.net"
CHAIN_ID=43522
# Admin Wallet Private Key (Gas Payer, MemeVault owner)
ADMIN_PRIVATE_KEY=""

# Contract Addresses (contracts/script/Deploy.s.sol 실행 결과)
MY_TOKEN_ADDRESS=""
MEME_VAULT_ADDRESS=""

# --- AI Config ---
GEMINI_API_KEY=""

# --- External API ---
YOUTUBE_API_KEY=""

# --- Database ---
DATABASE_URL="file:./dev.db"
