// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id @default(autoincrement())
  loginId       String  @unique @map("login_id")
  password      String // scrypt 해시 (salt:hash)
  walletAddress String? @map("wallet_address")
  nickname      String  @unique
  userCode      String  @unique @map("user_code")

  // 현재 보유 포인트 (환전 시 차감됨)
  points       Int @default(0)
  // 주간 랭킹용 누적 포인트 (환전해도 유지됨, 매주 월요일 초기화)
  weeklyPoints Int @default(0) @map("weekly_points")

  isAdmin            Boolean   @default(false) @map("is_admin")
  lastNicknameChange DateTime? @map("last_nickname_change")

  createdQuests Quest[]
  submissions   Submission[]
  likes         Like[]
  comments      Comment[]
  ledger        PointLedger[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("users")
}

model Quest {
  id           Int     @id @default(autoincrement())
  creatorId    Int?    @map("creator_id")
  creator      User?   @relation(fields: [creatorId], references: [id])
  title        String
  content      String?
  targetViews  Int     @default(0) @map("target_views")
  rewardPoints Int     @map("reward_points")

  // NORMAL: AI 퀘스트, EVENT: 테마 이벤트, SNS: SNS 바이럴 (시스템 퀘스트)
  category String @default("NORMAL")

  // NORMAL 전용: 완료 시각 (조건부 UPDATE로 중복 보상 방지)
  completedAt DateTime? @map("completed_at")

  // EVENT 전용
  description String?
  tokenIcon   String?   @map("token_icon")
  tokenSymbol String?   @map("token_symbol")
  endsAt      DateTime? @map("ends_at")
  settledAt   DateTime? @map("settled_at")

  submissions Submission[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("quests")
}

model Submission {
  id      Int   @id @default(autoincrement())
  userId  Int   @map("user_id")
  user    User  @relation(fields: [userId], references: [id])
  questId Int   @map("quest_id")
  quest   Quest @relation(fields: [questId], references: [id])

  imageUrl      String  @map("image_url")
  status        String  @default("PENDING")
  aiScore       Int     @default(0) @map("ai_score")
  snsUrl        String? @unique @map("sns_url")
  lastViewCount Int     @default(0) @map("last_view_count")
  lastLikeCount Int     @default(0) @map("last_like_count")

  // 이 제출로 획득한 포인트 기록 (히스토리용)
  earnedPoints Int @default(0) @map("earned_points")

  likes       Like[]
  comments    Comment[]
  submittedAt DateTime  @default(now()) @map("submitted_at")

  @@map("submissions")
}

// 유저당 게시물 하나에 좋아요는 한 번만
model Like {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  submissionId Int        @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  @@unique([userId, submissionId])
  @@map("likes")
}

model Comment {
  id           Int        @id @default(autoincrement())
  content      String
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  submissionId Int        @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("comments")
}

// 포인트 원장: 모든 적립/차감 기록 (감사 추적 + 환전 실패 시 환불 근거)
model PointLedger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // +적립 / -차감
  reason    String // AI_QUEST, SNS, SNS_BONUS, EVENT_PRIZE, SWAP, SWAP_REFUND
  refId     Int?     @map("ref_id") // 관련 submission id 등
  txHash    String?  @map("tx_hash")
  status    String   @default("DONE") // DONE, PENDING, FAILED
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("point_ledger")
}
